{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "A 股财报诊断 Skill 自定义数据源 Schema",
  "description": "API/数据库型自定义数据源的结构契约。field_id 对照 references/indicator-dictionary.md 数据需求清单编号（发布后冻结，不得复用或重排）。meta 口径声明对应 C2 校验；source_note 对应 C4 溯源校验。",
  "type": "object",
  "required": ["meta", "records"],
  "additionalProperties": false,
  "properties": {
    "meta": {
      "type": "object",
      "required": ["source_name", "provider_type", "is_consolidated", "uses_parent_net_profit", "extracted_at"],
      "additionalProperties": false,
      "properties": {
        "source_name": {
          "type": "string",
          "description": "数据源名称（C4 可溯源声明）"
        },
        "provider_type": {
          "type": "string",
          "enum": ["excel", "wind", "ifind", "choice", "internal_api", "other"]
        },
        "is_consolidated": {
          "type": "boolean",
          "description": "合并报表口径声明（C2），准入要求必须为 true"
        },
        "uses_parent_net_profit": {
          "type": "boolean",
          "description": "利润字段为归母净利润声明（C2），准入要求必须为 true"
        },
        "caliber_note": {
          "type": "string",
          "description": "口径补充说明（可选）：报告期口径、单位换算说明等"
        },
        "extracted_at": {
          "type": "string",
          "format": "date",
          "description": "数据提取时间（YYYY-MM-DD）"
        }
      }
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["stock_code", "period", "field_id", "value", "unit", "currency", "source_note"],
        "additionalProperties": false,
        "properties": {
          "stock_code": {
            "type": "string",
            "description": "证券代码"
          },
          "period": {
            "type": "string",
            "pattern": "^\\d{4}-(FY|H1|Q1|Q3)$",
            "description": "报告期：YYYY-FY / YYYY-H1 / YYYY-Q1 / YYYY-Q3"
          },
          "field_id": {
            "type": "string",
            "pattern": "^[A-D]\\d{2}[ab]?$|^E[1-3]-[AB]\\d{2}$",
            "description": "字段编号：A01–A35 / B01–B20 / C01–C07 / D01–D14；E 组仅接受槽位编址（如 E1-A01）；[ab] 后缀仅 B06a/B06b 实际使用"
          },
          "field_name": {
            "type": "string",
            "description": "字段中文名（与字典对照，便于人读）"
          },
          "value": {
            "type": ["number", "null"],
            "description": "数值；null 视同 MISSING（禁止估算填充）"
          },
          "unit": {
            "type": "string",
            "enum": ["yuan", "wanyuan", "yiyuan"]
          },
          "currency": {
            "type": "string",
            "enum": ["CNY", "HKD", "USD"]
          },
          "source_note": {
            "type": "string",
            "description": "溯源标识（接口/库表/文件 + 提取批次）"
          }
        }
      }
    }
  }
}
